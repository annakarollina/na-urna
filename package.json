{
  "name": "minha-colinha",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --mode e2e --host 127.0.0.1 --port 4175",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.pipeline.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "data:tse:compile": "tsc -p tsconfig.pipeline.build.json",
    "data:tse": "npm run data:tse:compile && node .tmp/tse-pipeline-build/scripts/tse/run.js",
    "data:geography": "npm run data:tse:compile && node .tmp/tse-pipeline-build/scripts/geography/update-state-boundaries.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "globals": "17.4.0",
    "happy-dom": "20.11.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "preact": "10.29.8"
  }
}
